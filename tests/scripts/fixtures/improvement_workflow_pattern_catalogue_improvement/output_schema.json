{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nonagentic.ai/schemas/improvement/workflow/pattern_catalogue_improvement.json",
  "title": "WorkflowPatternCatalogueImprovementProposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal",
    "predicted_deltas",
    "rationale",
    "confidence"
  ],
  "properties": {
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "body"
      ],
      "properties": {
        "kind": {
          "const": "pattern"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "patterns_to_add",
            "patterns_to_deprecate"
          ],
          "properties": {
            "patterns_to_add": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "definition"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "definition": {
                    "type": "object"
                  }
                }
              }
            },
            "patterns_to_deprecate": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "reason"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "predicted_deltas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cost_pct": {
          "type": "number"
        },
        "latency_pct": {
          "type": "number"
        },
        "validation_delta": {
          "type": "number"
        }
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
