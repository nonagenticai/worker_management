# ==============================================================================
# Worker Management - Secrets Configuration
# ==============================================================================
# IMPORTANT: This file contains ONLY secrets (passwords, keys, tokens)
# All other configuration belongs in docker-compose.yml
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Credentials
# ------------------------------------------------------------------------------
POSTGRES_PASSWORD_WORKER_MANAGEMENT=CHANGE_ME_SECURE_PASSWORD

# ------------------------------------------------------------------------------
# Keycloak Authentication (OAuth2 Standard)
# ------------------------------------------------------------------------------
SERVICE_CLIENT_ID=worker-management
SERVICE_CLIENT_SECRET=CHANGE_ME_CLIENT_SECRET
KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_REALM=secure-apps

# ------------------------------------------------------------------------------
# JWT Authentication Configuration
# ------------------------------------------------------------------------------
# JWT algorithm for token verification (RS256, RS512, HS256, etc.)
JWT_ALGORITHM=RS256

# Option 1: Provide public key directly (base64 or PEM format)
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBg...\n-----END PUBLIC KEY-----"

# Option 2: Provide path to public key file
JWT_PUBLIC_KEY_PATH=/app/certs/public_key.pem

# Optional: Expected issuer (validate 'iss' claim)
# JWT_ISSUER=https://keycloak.example.com/realms/secure-apps

# Optional: Expected audience (validate 'aud' claim)
# JWT_AUDIENCE=worker-management

# ------------------------------------------------------------------------------
# LLM/AI API Keys
# ------------------------------------------------------------------------------
OPENAI_API_KEY=CHANGE_ME_API_KEY
GROQ_API_KEY=CHANGE_ME_API_KEY
GROQ_API_KEY_TWO=CHANGE_ME_API_KEY
DEEPSEEK_API_KEY=CHANGE_ME_API_KEY
XAI_API_KEY=CHANGE_ME_API_KEY

# ------------------------------------------------------------------------------
# External Service API Keys
# ------------------------------------------------------------------------------
SERPER_API_KEY=CHANGE_ME_API_KEY
LANGTRACE_API_KEY=CHANGE_ME_API_KEY
LCA_CLI_TOKEN=CHANGE_ME_TOKEN

# ------------------------------------------------------------------------------
# Grafana Cloud API Key
# ------------------------------------------------------------------------------
GRAFANA_API_KEY=CHANGE_ME_API_KEY

# ------------------------------------------------------------------------------
# code_graph_helper Integration (Remote Agent Execution)
# ------------------------------------------------------------------------------
# Service endpoint for remote agent execution in repo containers
CODING_SERVICE_URL=https://coding.example.com
