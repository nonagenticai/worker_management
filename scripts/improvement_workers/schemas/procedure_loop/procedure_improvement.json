{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nonagentic.ai/schemas/improvement/procedure/improvement.json",
  "title": "ProcedureImprovementProposal",
  "type": "object",
  "required": ["candidate_procedure", "rationale", "expected_impact", "scope_of_change"],
  "additionalProperties": false,
  "properties": {
    "candidate_procedure": {
      "type": "object",
      "required": ["name", "steps"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "preconditions": { "type": "array", "items": { "type": "string" } },
        "postconditions": { "type": "array", "items": { "type": "string" } },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["stepNumber", "name", "actionType"],
            "additionalProperties": false,
            "properties": {
              "stepNumber": { "type": "integer", "minimum": 1 },
              "name": { "type": "string", "minLength": 1 },
              "actionType": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "preconditions": { "type": "array", "items": { "type": "string" } },
              "postconditions": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "rationale": { "type": "string", "minLength": 1 },
    "expected_impact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "delta_execution_success_rate": { "type": "number" },
        "delta_clarity": { "type": "string" },
        "breaking_changes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "scope_of_change": {
      "type": "string",
      "enum": ["step_description_only", "preconditions_postconditions", "step_reorder", "add_remove_steps"]
    }
  }
}
