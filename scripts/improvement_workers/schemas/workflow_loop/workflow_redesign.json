{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nonagentic.ai/schemas/improvement/workflow/redesign.json",
  "title": "WorkflowRedesignProposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal", "predicted_deltas", "rationale", "confidence"],
  "properties": {
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "body"],
      "properties": {
        "kind": { "const": "patch" },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": ["patch"],
          "properties": {
            "patch": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["op", "path"],
                "properties": {
                  "op": {
                    "enum": ["add", "remove", "replace", "move", "copy", "test"]
                  },
                  "path": { "type": "string", "minLength": 1 },
                  "from": { "type": "string" },
                  "value": {}
                }
              }
            }
          }
        }
      }
    },
    "predicted_deltas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cost_pct": { "type": "number" },
        "latency_pct": { "type": "number" },
        "validation_delta": { "type": "number" }
      }
    },
    "rationale": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
