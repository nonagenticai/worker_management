{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nonagentic.ai/schemas/improvement/prompt/library_consistency_management.json",
  "title": "PromptLibraryConsistencyProposal",
  "type": "object",
  "required": ["candidate_system_prompt", "rationale", "expected_impact", "scope_of_change"],
  "additionalProperties": false,
  "properties": {
    "candidate_system_prompt": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "expected_impact": {
      "type": "object",
      "required": ["delta_p95_ms", "delta_failure_rate", "delta_cost_usd_per_call"],
      "properties": {
        "delta_p95_ms": { "type": "number" },
        "delta_failure_rate": { "type": "number" },
        "delta_cost_usd_per_call": { "type": "number" }
      },
      "additionalProperties": false
    },
    "scope_of_change": { "type": "string", "enum": ["minor_wording", "structural", "instruction_set"] }
  }
}
